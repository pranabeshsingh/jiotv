# JioTV Headless IPTV Server Configuration

# Server Binding
HOST=0.0.0.0
PORT=5001
BASE_URL=https://tv.trylocalhost.com

# Dashboard Security (Optional - leave empty for open local access)
DASHBOARD_PASSWORD=admin
SECRET_KEY=generate_random_secret_string_here

# Upstream Residential Proxy (Optional)
# Leave PROXY_ENABLED=false for direct connection (default)
# Only required if running on cloud VMs (e.g. Oracle/AWS) blocked by Jio Fastly CDN (HTTP 450)
PROXY_ENABLED=false
PROXY_URL=http://100.107.251.122:8888

# Storage Directory
DATA_DIR=./data
